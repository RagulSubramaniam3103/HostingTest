<Window x:Class="EWOMS_WPF_Administration.Registeration.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegisterView" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="20">

            <!-- Username -->
            <TextBlock Text="Username:" FontWeight="Bold" Margin="0,5"/>
            <TextBox Text="{Binding UserName}" Margin="0,5"/>

            <!-- Full Name -->
            <TextBlock Text="Full Name:" FontWeight="Bold" Margin="0,5"/>
            <TextBox Text="{Binding FullName}" Margin="0,5"/>

            <!-- Email -->
            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,5"/>
            <TextBox Text="{Binding Email}" Margin="0,5"/>

            <!-- Password -->
            <TextBlock Text="Password:" FontWeight="Bold" Margin="0,5"/>
            <PasswordBox x:Name="pwdBox" Margin="0,5"/>

            <!-- Confirm Password -->
            <TextBlock Text="Confirm Password:" FontWeight="Bold" Margin="0,5"/>
            <PasswordBox x:Name="confirmPwdBox" Margin="0,5"/>

            <!-- Role -->
            <TextBlock Text="Role:" FontWeight="Bold" Margin="0,5"/>
            <ComboBox SelectedValue="{Binding Role}" SelectedValuePath="Content" Margin="0,5">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Manager"/>
            </ComboBox>

            <!-- Register Button -->
            <Button Content="Register"
                    Command="{Binding RegisterCommand}"
                    CommandParameter="{Binding ElementName=pwdBox}"
                    Margin="0,10" Height="30"/>

            <!-- Message -->
            <TextBlock Text="{Binding Message}" Foreground="Red" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>